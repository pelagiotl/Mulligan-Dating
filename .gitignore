# Environment variables
.env
.env.local
.env.production
.env.development
backend/.env
backend/.env.local
backend/.env.production
backend/.env.development

# Database files
*.db
*.sqlite
*.sqlite3
backend/mulligan.db
backend/database.sqlite
backend/*.db

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
backend/dist/
frontend/dist/
build/
backend/build/
frontend/build/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local tool venvs (e.g. icon scripts)
.venv-icon/

# Temporary files
tmp/
temp/
*.tmp

# Secrets and keys
*.pem
*.key
*.cert
secrets/
keys/
# Firebase Service Account key (do not commit)
**/firebase-adminsdk-*.json
mobile/mulligan-ba16c-firebase-adminsdk-*.json

# Mobile local trash / duplicate Finder copies (see mobile/.gitignore)
mobile/_trash_node_modules_old/
mobile/node_modules_bad_*/













