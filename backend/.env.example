# Copy to .env for local development. Do not commit real secrets.

NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-in-production

# Optional QA/test phone login bypass. Leave disabled in normal production.
# When enabled, numbers listed here skip SMS delivery and can verify with TEST_PHONE_CODE.
# TEST_PHONE_LOGIN_ENABLED=true
# TEST_PHONE_NUMBERS=+15414011862,+15413163939
# TEST_PHONE_CODE=123456
# Optional: return the code from /sms/send-code in production responses for easier QA.
# TEST_PHONE_LOGIN_SHOW_CODE=true
# Auto-create stage1 match when both accounts exist (also runs on login/verify). phoneA:phoneB pairs, comma-separated.
# Default pair if unset: (541) 401-1862 ↔ (541) 316-3939
# TEST_AUTO_MATCH_PHONE_PAIRS=5414011862:5413163939

# Production web app origin(s) for CORS — comma-separated, no trailing slashes.
# Example (Render-hosted frontend):
# ALLOWED_ORIGINS=https://mulligan-frontend.onrender.com

# Optional: base URL for referral links / future payment redirects (documented in DEPLOYMENT.md).
# FRONTEND_URL=https://mulligan-frontend.onrender.com

# Web card payments (Authorize.Net / Payment Cloud — Accept Hosted iframe).
# Set FRONTEND_URL (or ALLOWED_ORIGINS first origin) so return URLs and IFrameCommunicator.html match your SPA origin.
#
# Two different secrets: (1) API Login ID — short id from the gateway. (2) Transaction Key — longer secret.
# Do not put the transaction key in the API login variable.
#
# Either naming style works (AUTHORIZENET_* preferred; AUTHNET_* accepted):
# AUTHORIZENET_API_LOGIN=   or AUTHNET_API_LOGIN=
# AUTHORIZENET_TRANSACTION_KEY=   or AUTHNET_TRANSACTION_KEY=
# AUTHORIZENET_SANDBOX=true   or AUTHNET_SANDBOX=true
# Optional overrides if your processor uses different hosts than Authorize.Net defaults:
# AUTHORIZENET_API_URL=   or AUTHNET_API_URL=
# AUTHORIZENET_HOSTED_PAYMENT_URL=   or AUTHNET_HOSTED_PAYMENT_URL=

# Apple Pay on the Web (Safari / iOS) — optional; requires Authorize.Net + FRONTEND_URL hostname.
# 1) Apple Developer → Identifiers → Merchant IDs → your merchant ID → create a Merchant Identity Certificate
#    (CSR from Keychain), download .cer, export cert + private key as PEM for the server.
# 2) Register your exact web origin domain for Apple Pay and host the domain-association file on the frontend
#    at /.well-known/apple-developer-merchantid-domain-association (see Apple docs).
# APPLE_PAY_MERCHANT_ID=merchant.com.example.web
# APPLE_PAY_DISPLAY_NAME=Mulligan
# APPLE_PAY_IDENTITY_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# APPLE_PAY_IDENTITY_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Optional: override FQDN sent to Apple (defaults to hostname of FRONTEND_URL / first ALLOWED_ORIGINS):
# APPLE_PAY_INITIATIVE_CONTEXT=your-frontend.onrender.com

# Google Pay (Android/web API + Authorize.Net gateway tokenization)
# GOOGLE_PAY_MERCHANT_ID comes from Google Pay & Wallet Console (looks like BCR2...).
# AUTHORIZENET_PAYMENT_GATEWAY_ID is your Authorize.Net "Payment Gateway ID" used as gatewayMerchantId.
# GOOGLE_PAY_MERCHANT_ID=
# AUTHORIZENET_PAYMENT_GATEWAY_ID=   or AUTHNET_PAYMENT_GATEWAY_ID=

# API URL is not set here; clients use EXPO_PUBLIC_API_URL / VITE_API_URL pointing at this server.

# Optional: comma-separated US phone numbers (digits only, no +1) that get admin API/UI access
# without setting users.is_admin in the DB. Supplementary to any built-in allowlist in auth middleware.
# ADMIN_PHONES=5551234567,5559876543

# Optional: comma-separated user UUIDs with admin access (bypasses phone / is_admin column).
# ADMIN_USER_IDS=

# Primary owner user IDs (comma-separated UUIDs) for stricter owner-only moderation paths.
# OWNER_USER_IDS=

# Web Push (browser / PWA). Generate keys: npx web-push generate-vapid-keys
# Set the same public key in the frontend as VITE_VAPID_PUBLIC_KEY.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:):
# VAPID_CONTACT_EMAIL=mailto:ops@example.com
