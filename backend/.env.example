# Copy to .env for local development. Do not commit real secrets.

NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-in-production

# Production web app origin(s) for CORS — comma-separated, no trailing slashes.
# Example (Render-hosted frontend):
# ALLOWED_ORIGINS=https://mulligan-frontend.onrender.com

# Optional: base URL for referral links / future payment redirects (documented in DEPLOYMENT.md).
# FRONTEND_URL=https://mulligan-frontend.onrender.com

# API URL is not set here; clients use EXPO_PUBLIC_API_URL / VITE_API_URL pointing at this server.
