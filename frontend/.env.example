# Copy to .env.local or configure in Render “Environment” for static site builds.

# Backend API (production example on Render)
VITE_API_URL=https://mulligan-backend.onrender.com

# Local dev: leave VITE_API_URL empty to use Vite proxy, or set:
# VITE_API_URL=http://localhost:3001

# Optional: tunnel during beta
# VITE_NGROK_URL=https://your-subdomain.ngrok-free.dev

# Web Push — must match backend VAPID_PUBLIC_KEY (see backend/.env.example).
# VITE_VAPID_PUBLIC_KEY=

# Optional: show “Preview match celebration” in Settings on non-Render hosts (enabled automatically on *.onrender.com and in Vite dev).
# VITE_ENABLE_MATCH_CELEBRATION_PREVIEW=true
