# Copy to .env.local or configure in Render for frontend builds.

# --- Recommended production (Web Service + same-origin API proxy) ---
# Build env: leave VITE_API_URL unset so the app calls /api on the same host.
# Build env: VITE_SOCKET_URL=https://mulligan-backend.onrender.com
# Runtime env: API_PROXY_TARGET=https://mulligan-backend.onrender.com
# Start command: npm start  (runs server.mjs — proxies /api to the backend)

# --- Alternative (cross-origin API; requires backend ALLOWED_ORIGINS) ---
# VITE_API_URL=https://mulligan-backend.onrender.com

# Local dev: leave VITE_API_URL empty to use Vite proxy, or set:
# VITE_API_URL=http://localhost:3001

# Optional: tunnel during beta
# VITE_NGROK_URL=https://your-subdomain.ngrok-free.dev

# Web Push — must match backend VAPID_PUBLIC_KEY (see backend/.env.example).
# VITE_VAPID_PUBLIC_KEY=
