{
  "name": "mulligan",
  "version": "1.0.0",
  "description": "A modern dating app where second chances lead to first connections",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:render": "npm run build:embedded --workspace=frontend && npm run build --workspace=backend",
    "start": "npm run start --workspace=backend",
    "create-match-by-phone": "npm run create-match-by-phone --workspace=backend --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

