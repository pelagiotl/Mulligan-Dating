{
  "expo": {
    "name": "Mulligan",
    "slug": "mulligan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lukepelagiotomerlin.mulligan",
      "buildNumber": "22",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mulligan uses your location to find matches near you.",
        "NSPhotoLibraryUsageDescription": "Mulligan needs access to your photos to upload profile pictures.",
        "NSCameraUsageDescription": "Mulligan needs access to your camera to take profile pictures and send photos or videos in chat.",
        "NSMicrophoneUsageDescription": "Mulligan needs microphone access to record voice messages in chat.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.lukepelagiotomerlin.mulligan",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B1538"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/**/*.mp3",
      "assets/**/*.wav",
      "assets/**/*.m4a"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mulligan uses your location to find matches near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mulligan needs access to your photos to upload profile pictures and send photos in chat.",
          "cameraPermission": "Mulligan needs access to your camera to take photos and send them in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Mulligan does not use the microphone. Audio playback is used for match notifications."
        }
      ],
      "@sentry/react-native",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.lukepelagiotomerlin.mulligan"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ffe7d520-859b-4e18-a2d8-10b607bbf90b"
      }
    },
    "newArchEnabled": true
  }
}