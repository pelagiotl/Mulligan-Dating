{
  "expo": {
    "name": "Mulligan",
    "slug": "mulligan",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12101c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mulligandating",
      "buildNumber": "195",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "NSLocationWhenInUseUsageDescription": "Mulligan uses your location to show people and hangs near you.",
        "NSPhotoLibraryUsageDescription": "Mulligan needs access to your photos to upload profile pictures.",
        "NSCameraUsageDescription": "Mulligan needs access to your camera to take profile pictures and send photos or videos in chat.",
        "NSMicrophoneUsageDescription": "Mulligan needs microphone access to record voice messages in chat.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.mulligandating",
      "versionCode": 81,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#926ce2"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/**/*.mp3",
      "assets/**/*.wav",
      "assets/**/*.m4a"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "28.0.12674087",
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mulligan uses your location to show people and hangs near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mulligan needs access to your photos to upload profile pictures and send photos in chat.",
          "cameraPermission": "Mulligan needs access to your camera to take photos and send them in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "defaultChannelId": "default"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Mulligan does not use the microphone. Audio playback is used for match notifications."
        }
      ],
      "@sentry/react-native",
      "expo-asset"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "useEmbeddedUpdate": true
    },
    "extra": {
      "eas": {
        "projectId": "ffe7d520-859b-4e18-a2d8-10b607bbf90b"
      }
    },
    "newArchEnabled": true
  }
}
