# Copy this file to .env and fill in your values.
# Do not commit .env (it is in .gitignore).

# Backend API (optional; defaults to production URL)
# EXPO_PUBLIC_API_URL=https://mulligan-backend.onrender.com

# RevenueCat – in-app purchases (Settings / buy tokens)
# Get from RevenueCat dashboard: Project Settings > API keys (use test key for dev)
# Prefer platform-specific keys so Android and iOS each use the correct SDK key.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_key_here
# Optional fallback key (used only when a platform-specific key is missing):
# EXPO_PUBLIC_REVENUECAT_API_KEY=test_your_fallback_key_here

# Sentry (optional)
# EXPO_PUBLIC_SENTRY_DSN=

# If `npx expo start` hangs after "env: export ...", try skipping the Sentry Expo plugin locally:
# EXPO_NO_SENTRY_PLUGIN=1
# (Unset for EAS builds so @sentry/react-native stays in app.json plugins.)

# If Expo still sits silent for minutes after env (native scheme scan), use the quick script:
#   npm run start:quick
# Same as: expo start --scheme app.mulligandating --offline
