# Copy this file to .env and fill in your values.
# Do not commit .env (it is in .gitignore).

# Backend API (optional; defaults to production URL)
# EXPO_PUBLIC_API_URL=https://mulligan-backend.onrender.com

# Stripe – required for in-app token purchases (Settings / buy flow)
# Get from https://dashboard.stripe.com/apikey (use pk_test_... for dev)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Sentry (optional)
# EXPO_PUBLIC_SENTRY_DSN=
